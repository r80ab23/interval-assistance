# Copy to .env for local development. Never commit .env or real credentials.
IA_ENVIRONMENT=development
IA_DATABASE_URL=sqlite:///./interval_assistance.db
IA_LOG_LEVEL=INFO
IA_LOG_FORMAT=json
# Development identity (development/test environments only; rejected in production).
IA_DEV_IDENTITY_ENABLED=true
IA_DEV_IDENTITY_ROLE=coach
